  "html": "<table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"640\" style=\"border-collapse:collapse;width:640px;font-family:{{brand.fontFamily}};\"><tr><td width=\"150\" valign=\"middle\" style=\"width:150px;padding:10px 20px 0 0;\"><a href=\"{{brand.website}}\" style=\"text-decoration:none;\"><img src=\"{{brand.logoUrl}}\" width=\"{{brand.logoWidth}}\" alt=\"{{brand.logoAlt}}\" style=\"display:block;border:0;width:{{brand.logoWidth}}px;height:auto;\"></a></td><td valign=\"middle\" style=\"padding:10px 16px 0 0;\"><div style=\"font-size:20px;line-height:25px;font-weight:bold;color:{{brand.primaryColor}};\">{{user.displayName}}</div>{{#user.jobTitle}}<div style=\"font-size:14px;line-height:19px;color:{{brand.secondaryColor}};padding-top:3px;\">{{user.jobTitle}}</div>{{/user.jobTitle}}</td><td rowspan=\"2\" width=\"190\" valign=\"middle\" align=\"center\" bgcolor=\"{{brand.panelColor}}\" style=\"width:190px;background-color:{{brand.panelColor}};padding:14px 10px;text-align:center;font-size:14px;line-height:22px;font-weight:bold;\">{{#user.phone}}<div><span style=\"color:{{brand.accentColor}};\">T:</span>&nbsp;<a href=\"{{user.phoneHref}}\" style=\"color:{{brand.primaryColor}};text-decoration:none;\">{{user.phone}}</a></div>{{/user.phone}}{{#user.mobilePhone}}<div><span style=\"color:{{brand.accentColor}};\">M:</span>&nbsp;<a href=\"{{user.mobilePhoneHref}}\" style=\"color:{{brand.primaryColor}};text-decoration:none;\">{{user.mobilePhone}}</a></div>{{/user.mobilePhone}}<div><a href=\"{{brand.website}}\" style=\"color:{{brand.accentColor}};text-decoration:underline;\">{{brand.websiteLabel}}</a></div><div style=\"padding-top:10px;\"><img src=\"{{brand.iconsUrl}}\" width=\"{{brand.iconsWidth}}\" alt=\"\" style=\"border:0;width:{{brand.iconsWidth}}px;height:auto;\"></div></td></tr><tr><td colspan=\"2\" valign=\"bottom\" style=\"padding:12px 8px 4px 0;font-size:10px;line-height:14px;color:{{brand.secondaryColor}};\">{{brand.legalName}}, {{brand.address}}</td></tr>{{#campaign}}<tr><td colspan=\"3\" style=\"padding:12px 0 0 0;\"><a href=\"{{link}}\" style=\"text-decoration:none;\"><img src=\"{{imageUrl}}\" width=\"{{imageWidth}}\" alt=\"{{alt}}\" style=\"display:block;border:0;width:{{imageWidth}}px;max-width:100%;height:auto;\"></a></td></tr>{{/campaign}}{{#brand.legal}}<tr><td colspan=\"3\" style=\"padding:10px 0 0 0;font-size:9px;line-height:12px;color:{{brand.mutedColor}};\">{{brand.legal}}</td></tr>{{/brand.legal}}</table>",
  "replyHtml": "<table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;font-family:{{brand.fontFamily}};font-size:13px;line-height:19px;\"><tr><td style=\"border-left:3px solid {{brand.secondaryColor}};padding:2px 0 2px 10px;\"><span style=\"font-weight:bold;color:{{brand.primaryColor}};\">{{user.displayName}}</span>{{#user.jobTitle}}<span style=\"color:{{brand.secondaryColor}};\"> | {{user.jobTitle}}</span>{{/user.jobTitle}}<br>{{#user.mobilePhone}}<span style=\"color:{{brand.accentColor}};font-weight:bold;\">M:</span>&nbsp;<a href=\"{{user.mobilePhoneHref}}\" style=\"color:{{brand.primaryColor}};text-decoration:none;\">{{user.mobilePhone}}</a>&nbsp;&nbsp;{{/user.mobilePhone}}{{^user.mobilePhone}}{{#user.phone}}<span style=\"color:{{brand.accentColor}};font-weight:bold;\">T:</span>&nbsp;<a href=\"{{user.phoneHref}}\" style=\"color:{{brand.primaryColor}};text-decoration:none;\">{{user.phone}}</a>&nbsp;&nbsp;{{/user.phone}}{{/user.mobilePhone}}<a href=\"{{brand.website}}\" style=\"color:{{brand.accentColor}};font-weight:bold;text-decoration:underline;\">{{brand.websiteLabel}}</a></td></tr></table>"
